{
    // control_station.py now runs inside the env550lab conda env -- PyQt5, cv2, xarm and
    // pupil_apriltags live there, not in the system python. Point the analyzer at the same
    // interpreter or Pylance cannot resolve any of them.
    // Change this path if your Anaconda prefix differs.
    "python.defaultInterpreterPath": "${userHome}/anaconda3/envs/env550lab/bin/python",

    // lite6_sim is pip-installed into the env by install_scripts/install_conda_env.sh, but
    // src/lite6arm.py and src/lite6arm_sim.py also add src/mujoco_sim to sys.path at runtime.
    // This lets Pylance resolve `from lite6_sim.lcm_msgs import ...` either way.
    "python.analysis.extraPaths": [
        "src/mujoco_sim"
    ],
    "python.analysis.autoSearchPaths": true
}
